# Copie para .env.local e preencha. Nunca commite o .env.local.

# ── Fontes de dados ──────────────────────────────────────────────
# football-data.org (fonte reserva). Cadastro grátis em https://www.football-data.org/client/register
# Sem o token, o orquestrador simplesmente pula esta fonte.
FOOTBALL_DATA_TOKEN=

# E-sports (CS2, LoL e Valorant: calendário e resultados, SEM ao vivo). Cadastro grátis em https://pandascore.co
# (o token só você pode criar). Sem ele, a seção E-sports fica desligada e o link some do menu.
PANDASCORE_TOKEN=
# Só para desenvolvimento e testes: aponta o app para um servidor falso do PandaScore. Deixe vazio em produção.
PANDASCORE_BASE_URL=

# Só para o script scripts/check-sources.ts (evita o limite de 60 req/h da API do GitHub).
GITHUB_TOKEN=

# ── Supabase (dados normalizados) — fase posterior ───────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Notificações push (Web Push) — veja docs/NOTIFICACOES.md ─────
# Gere tudo de uma vez com: npm run push:keys
# Sem as três primeiras, os avisos ficam desligados (o botão nem aparece).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail (mailto:) ou site (https://) seu: o serviço de push usa para te contatar.
VAPID_SUBJECT=mailto:voce@exemplo.com
# Protege GET /api/cron/push (o job de avisos). Em produção, sem ele a rota não existe.
# O agendador envia: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Protege GET /api/status (obrigatório em produção, senão a rota responde 404).
# Envie como: Authorization: Bearer <token>
STATUS_TOKEN=
